{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/app.vue",
    "app/pages/**/*.vue",
    "app/layouts/**/*.vue",
    "app/middleware/**/*.ts",
    "app/plugins/**/*.ts",
    "nuxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.ts",
    "scripts/**/*.mjs",
    "tests/**/*.spec.ts"
  ],
  "project": ["app/**/*.{ts,vue}", "scripts/**/*.mjs", "tests/**/*.ts"],
  "ignore": ["app/assets/**", ".nuxt/**", ".output/**"],
  "ignoreDependencies": [
    "@fontsource-variable/archivo",
    "@fontsource-variable/chivo-mono",
    "@phosphor-icons/web",
    "jiti",
    "vue-tsc",
    "jsonc-eslint-parser",
    "yaml-eslint-parser",
    "vue-eslint-parser"
  ],
  "vue": true,
  "includeEntryExports": true
}
